{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "border_patterns.schema.json",
  "title": "Border patterns dataset schema",
  "type": "object",
  "required": [
    "border_patterns"
  ],
  "properties": {
    "border_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "pattern_type",
          "visual_structure",
          "colors",
          "period",
          "usage_context",
          "prompt_tokens"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "pattern_type": {
            "type": "string",
            "enum": [
              "geometric",
              "floral",
              "hieroglyphic",
              "composite"
            ]
          },
          "visual_structure": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "period": {
            "type": "string"
          },
          "usage_context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prompt_tokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}